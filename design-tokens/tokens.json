{
  "name": "ShopVerse Design Tokens",
  "version": "1.0.0",
  "project": "Project 1 - Multi-Vendor Marketplace App",
  "author": "Axlero UI/UX Group 1",
  "grid": {
    "base": 8,
    "unit": "px"
  },
  "color": {
    "brand": {
      "primary": { "value": "#A64028", "description": "Brand Terracotta - Primary actions & active tabs" },
      "primaryHover": { "value": "#82331F", "description": "Darkened brand on pointer hover" },
      "primaryDisabled": { "value": "#DADAD4", "description": "Disabled state button background" },
      "tint": { "value": "#F4E7DF", "description": "Subtle brand accent tint for badges and cards" }
    },
    "neutral": {
      "ink": { "value": "#222820", "description": "Primary high-contrast text (passes WCAG AAA)" },
      "muted": { "value": "#68716B", "description": "Secondary captions, labels, and disabled icons" },
      "border": { "value": "#DED9D1", "description": "Dividers, hairline strokes, and input borders" },
      "canvas": { "value": "#F7F4EF", "description": "App background canvas" },
      "surface": { "value": "#FFFFFF", "description": "Card surface, modal cards, and input fill" }
    },
    "semantic": {
      "success": { "value": "#35664D", "description": "In stock badge, success alerts, confirmed orders" },
      "warning": { "value": "#C26A10", "description": "Low stock warning, pending reviews" },
      "error": { "value": "#D32F2F", "description": "Form validation errors, out of stock alerts" },
      "info": { "value": "#1F2A7C", "description": "Information badges and order tracking status" }
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "Arial, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "display": "Georgia, serif"
    },
    "scale": {
      "display": { "fontSize": "23px", "lineHeight": "30px", "fontWeight": "700" },
      "h1": { "fontSize": "20px", "lineHeight": "26px", "fontWeight": "700" },
      "h2": { "fontSize": "17px", "lineHeight": "22px", "fontWeight": "700" },
      "h3": { "fontSize": "15px", "lineHeight": "20px", "fontWeight": "600" },
      "body": { "fontSize": "13px", "lineHeight": "18px", "fontWeight": "400" },
      "bodySmall": { "fontSize": "11px", "lineHeight": "15px", "fontWeight": "400" },
      "caption": { "fontSize": "9px", "lineHeight": "12px", "fontWeight": "500" }
    }
  },
  "spacing": {
    "xxs": { "value": "4px" },
    "xs": { "value": "8px" },
    "sm": { "value": "12px" },
    "md": { "value": "16px" },
    "lg": { "value": "24px" },
    "xl": { "value": "32px" },
    "xxl": { "value": "40px" },
    "xxxl": { "value": "48px" }
  },
  "borderRadius": {
    "sm": { "value": "6px" },
    "md": { "value": "8px" },
    "lg": { "value": "12px" },
    "pill": { "value": "999px" }
  },
  "components": {
    "button": {
      "height": {
        "small": "32px",
        "medium": "38px",
        "large": "44px"
      },
      "radius": "8px",
      "padding": "0 16px"
    },
    "input": {
      "height": "38px",
      "radius": "7px",
      "border": "1px solid #D8D4CC"
    },
    "productCard": {
      "width": "170px",
      "height": "240px",
      "radius": "10px"
    }
  }
}
